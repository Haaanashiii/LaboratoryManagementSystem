# --- Server ---
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/laboratory_management?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=<generate-a-strong-random-secret-at-least-64-chars>
JWT_EXPIRE=7d

# --- CORS ---
# Development: http://localhost:5173
# Production: http://your-vm-ip-or-domain
CORS_ORIGIN=http://localhost:5173

# --- Email Policy ---
# Set to false in production
ENABLE_DEV_EMAIL_BYPASS=true

# --- File Upload ---
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# --- Production Values (set these on the VM) ---
# NODE_ENV=production
# TRUST_PROXY=1
# CORS_ORIGIN=http://10.4.89.165
# ENABLE_DEV_EMAIL_BYPASS=false
# ADMIN_EMAIL=admin@its.ac.id
# ADMIN_PASSWORD=StrongPassword123!
